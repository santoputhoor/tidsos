<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Both Agent and Controller are ASP.NET Core apps with top-level
      statements, so each implicitly declares a public partial `Program` in
      the global namespace for WebApplicationFactory<Program> to target.
      Referenced together, that name collides — the standard fix is an
      assembly alias on one side so the test project can disambiguate with
      `extern alias`.
    -->
    <ProjectReference Include="..\..\src\TidsOS.Controller\TidsOS.Controller.csproj" Aliases="global,ControllerHost" />
    <ProjectReference Include="..\..\src\TidsOS.Agent\TidsOS.Agent.csproj" Aliases="global,AgentHost" />
    <ProjectReference Include="..\..\src\TidsOS.Contracts\TidsOS.Contracts.csproj" />
  </ItemGroup>

</Project>